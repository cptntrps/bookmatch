#!/usr/bin/env bash
# WORK-1029 canonical gate receipt envelope
_gate_main() {
#!/usr/bin/env bash
# pre-push test gate (ADR-0020 adopted-standard, grocery pattern): the full suite
# must be green before anything leaves this repo. Exit code is pytest's — honest
# red-reject, no soft-fail path.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "pre-push: running bookmatch test suite (python3 -m pytest -q)" >&2
python3 -m pytest -q

}
if source /home/gui/src/infrastructure/bin/gate_capture.sh; then
    gate_capture bookmatch pre-push _gate_main "$@"
else
    echo "gate_capture: recorder unavailable; verdict NOT recorded" >&2
    ( _gate_main "$@" )
fi
